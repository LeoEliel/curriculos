{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curriculo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/", "/index.html", "/curriculo", "/curriculo.html", "/editar", "/editar/", "/api/*"]
  },
  // Crie o namespace com: npx wrangler kv namespace create CV
  // e cole o id abaixo. (Em `wrangler dev` o id é ignorado e usa KV local.)
  "kv_namespaces": [
    { "binding": "CV", "id": "2d66d169b5954b48be0484c3d8fb1602" }
  ],
  "observability": { "enabled": true }
}
